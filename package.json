{
  "name": "@inkesk/dike",
  "version": "0.1.0",
  "description": "Distributed Idempotency Key Engine (DIKE)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src/ --ext .ts"
  },
  "keywords": [
    "idempotency",
    "distributed-systems",
    "fencing-tokens",
    "blake3",
    "fastify",
    "redis",
    "postgres",
    "reverse-proxy"
  ],
  "author": "Kushagra Bhardwaj <@kush05bhardwaj>, Mrinal Prakash <@mrinalprakashfsd>",
  "license": "UNLICENSED",
  "private": true,
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.0",
    "@noble/hashes": "^1.7.1",
    "@sinclair/typebox": "^0.34.14",
    "fastify": "^5.2.1",
    "ioredis": "^5.5.0",
    "pg": "^8.13.1",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.4",
    "@types/pg": "^8.11.11",
    "@typescript-eslint/eslint-plugin": "^8.24.1",
    "@typescript-eslint/parser": "^8.24.1",
    "eslint": "^9.20.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^5.0.5"
  }
}
