# ==============================================================================
# DIKE (Distributed Idempotency Key Engine) Environment Configuration
# ==============================================================================

# Server Network Configuration
PORT=3000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# PostgreSQL ACID Persistent Storage (L3)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dike_dev
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=20
DATABASE_IDLE_TIMEOUT_MS=10000

# Redis Distributed Lease & Parking Storage (L2)
REDIS_URL=redis://localhost:6379
REDIS_KEY_PREFIX=dike:
REDIS_CLUSTER_MODE=false
REDIS_CONNECT_TIMEOUT_MS=5000

# Idempotency Engine Policy Defaults
IDEMPOTENCY_DEFAULT_TTL_MS=86400000
IDEMPOTENCY_LOCK_TIMEOUT_MS=30000
IDEMPOTENCY_PARKING_TIMEOUT_MS=10000
IDEMPOTENCY_MAX_PAYLOAD_BYTES=5242880

# Cryptographic Attestation Receipts
RECEIPT_SIGNING_ALGORITHM=HMAC-SHA256
RECEIPT_SECRET_KEY=change-me-to-a-secure-random-secret-key-32-chars-min

# Reverse Proxy Target (Phase 3)
UPSTREAM_TARGET_URL=http://localhost:8080
PROXY_STRICT_MODE=false
